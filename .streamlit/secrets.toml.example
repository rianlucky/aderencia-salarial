# Copie este arquivo para "secrets.toml" (mesma pasta) e preencha com os valores reais.
# secrets.toml já está no .gitignore — nunca commitar esse arquivo com credenciais reais.
#
# Projeto Neon "Central de Gente & Dados", usuário DEDICADO do painel
# (só leitura) — nunca o dono do banco. Lê core_view.funcionario_ativo
# (salário pessoa a pessoa, sem PII pessoal), mercado.mercado_salarial_muller
# (referência de mercado), core.mapeamento_diretoria* (diretoria/área — não
# precisa mais de JSON local nem de secret [mapping_diretoria]) e o login.
# Os scripts de etl/ NÃO usam este arquivo: usam
# etl/.env com o usuário de carga.

[neon]
database_url = "postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require"

# E-mail mostrado para quem ainda não tem acesso ("solicite a inclusão para ...")
[app]
email_suporte = "seu.email@empresa.com"
