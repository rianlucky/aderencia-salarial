# Copie este arquivo para "secrets.toml" (mesma pasta) e preencha com os valores reais.
# secrets.toml já está no .gitignore — nunca commitar esse arquivo com credenciais reais.
#
# Mesmo projeto Neon usado pelo painel Headcount (Desenvolvimento Organizacional/Headcount
# Total) — "Central de Gente & Dados". Este painel lê de interno.fato_funcionario_ativo
# (salário pessoa a pessoa, já espelhado do Databricks) e de interno.faixa_salarial_muller
# (referência de mercado, carregada por etl/upload_faixas_salariais.py).

[neon]
database_url = "postgresql://user:password@host/dbname?sslmode=require"

# Opcional — só necessário se etl/data/cc_mapping.json e special_mappings.json
# não existirem localmente (ex.: clone do GitHub, deploy no Streamlit Cloud,
# onde esses 2 arquivos ficam de fora de propósito por serem dado interno de
# RH). Cole o conteúdo de cada JSON como string entre aspas triplas. Sem isso
# e sem os arquivos locais, o app não quebra — só mostra "Não informado" pra
# Diretoria/Área de todo mundo.
[mapping_diretoria]
cc_mapping = '''
{}
'''
special_mappings = '''
{}
'''
